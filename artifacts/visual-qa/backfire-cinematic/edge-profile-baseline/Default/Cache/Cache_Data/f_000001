function bindChrome() {
  const sound = qs("#mute");
  sound?.addEventListener("click", () => {
    const enabled = backfireAudio.toggle();
    sound.setAttribute("aria-pressed", String(enabled));
    sound.setAttribute("aria-label", enabled ? "كتم صوت الموقع" : "تشغيل صوت الموقع");
    sound.innerHTML = `<span aria-hidden="true">${enabled ? "◉" : "○"}</span><b>الصوت</b>`;
  });
  const accountToggle = qs("#account-toggle");
  const accountPanel = qs("#account-panel");
  const mobileToggle = qs("#mobile-toggle");
  const mobilePanel = qs("#mobile-panel");
  const closeMenus = () => {
    if (accountPanel) accountPanel.hidden = true;
    accountToggle?.setAttribute("aria-expanded", "false");
    if (mobilePanel) mobilePanel.hidden = true;
    mobileToggle?.setAttribute("aria-expanded", "false");
    document.body.classList.remove("menu-open");
  };
  accountToggle?.addEventListener("click", (event) => {
    event.stopPropagation();
    if (!accountPanel) return;
    accountPanel.hidden = !accountPanel.hidden;
    accountToggle.setAttribute("aria-expanded", String(!accountPanel.hidden));
  });
  mobileToggle?.addEventListener("click", (event) => {
    event.stopPropagation();
    if (!mobilePanel) return;
    mobilePanel.hidden = !mobilePanel.hidden;
    mobileToggle.setAttribute("aria-expanded", String(!mobilePanel.hidden));
    document.body.classList.toggle("menu-open", !mobilePanel.hidden);
  });
  const outside = (event) => {
    const target = event.target;
    if (!accountPanel?.contains(target) && !accountToggle?.contains(target) && !mobilePanel?.contains(target) && !mobileToggle?.contains(target)) closeMenus();
  };
  const escape = (event) => {
    if (event.key !== "Escape") return;
    closeMenus();
    mobileToggle?.focus();
  };
  document.addEventListener("click", outside);
  document.addEventListener("keydown", escape);
  cleanups.push(() => document.removeEventListener("click", outside), () => document.removeEventListener("keydown", escape), () => document.body.classList.remove("menu-open"));
