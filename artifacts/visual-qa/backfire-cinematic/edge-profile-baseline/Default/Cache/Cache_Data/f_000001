    const next = Math.min(2, Math.floor(progress * 3));
    if (next === active) return;
    active = next;
    const frame = frames[next];
    number.textContent = frame[0];
    title.textContent = frame[1];
    copy.textContent = frame[2];
    stage.dataset.storyStage = String(next);
    qsa(".story-progress i").forEach((dot, index) => dot.classList.toggle("on", index <= next));
