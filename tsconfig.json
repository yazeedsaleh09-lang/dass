{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@crisis/shared": ["packages/shared/src/index.ts"],
      "@crisis/content": ["packages/content/src/index.ts"],
      "@crisis/i18n": ["packages/i18n/src/index.ts"],
      "@crisis/v2": ["packages/v2/src/index.ts"],
      "@dass/domain": ["packages/dass/src/index.ts"],
      "@backfire/domain": ["packages/backfire/src/index.ts"],
      "@backfire/ui": ["packages/backfire-ui/src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["packages/*/src/**/*.ts", "apps/*/src/**/*.ts"],
  "exclude": ["node_modules", "apps/web/**", "apps/v2web/**", "apps/dasstv/**", "apps/dassplayer/**", "apps/dasssite/**", "apps/bftv/**", "apps/bfplayer/**", "packages/dass-ui/**", "packages/backfire-ui/**"]
}
